meta {
  name: Invalid Date Filter
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/user/actions?start_date=not-a-date
  auth: none
}

params:query {
  start_date: not-a-date
}

headers {
  X-API-Key: {{api_key}}
}

tests {
  test("returns 400 with the JSON error shape", function () {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.all.keys("error");
    expect(res.body.error).to.be.a("string");
  });
}
