meta {
  name: Unknown Endpoint
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/user/does-not-exist
  auth: none
}

headers {
  X-API-Key: {{api_key}}
}

tests {
  test("returns 404 with the JSON error shape", function () {
    expect(res.status).to.equal(404);
    expect(res.body).to.have.all.keys("error");
    expect(res.body.error).to.be.a("string");
  });
}
