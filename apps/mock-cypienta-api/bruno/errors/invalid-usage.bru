meta {
  name: Invalid Usage
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/user/actions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-API-Key: {{api_key}}
}

body:json {
  {
    "usage": "not-a-number"
  }
}

tests {
  test("returns 400 with the JSON error shape", function () {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.all.keys("error");
    expect(res.body.error).to.be.a("string");
  });
}
