# Local mock. Replace these values to use your external upstream.
# Exported variables override this file.
API_URL=http://127.0.0.1:40759
API_KEY=local-dev-key

API_TIMEOUT_SECONDS=10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Production requires a random secret of at least 50 characters; leave blank for development.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
LOG_LEVEL=INFO
# For a frontend on a different port, prefer a dev-server /api proxy to this backend.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
