meta {
  name: usage-backend Endpoints
  type: http
  seq: 1
}

get {
  url: {{base_url}}/
  body: none
  auth: none
}

tests {
  test("returns backend endpoint discovery", function () {
    expect(res.status).to.equal(200);
    expect(res.body.service).to.equal("usage-backend");
    expect(res.body.endpoints.actions).to.equal("/api/user/actions");
  });

  test("lists all seven time presets", function () {
    expect(res.body.timeframes).to.deep.equal(["15m", "30m", "1h", "3h", "12h", "1d", "7d"]);
  });
}
