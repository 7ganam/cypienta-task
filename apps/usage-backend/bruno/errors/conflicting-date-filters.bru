meta {
  name: Conflicting Date Filters
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/user/actions?timeframe=15m&start_date=2026-01-01
  auth: none
}

tests {
  test("returns 400 with the JSON error shape", function () {
    expect(res.status).to.equal(400);
    expect(res.body).to.have.all.keys("error");
    expect(res.body.error).to.be.a("string");
  });
}
